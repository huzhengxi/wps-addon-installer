{
  "name": "wps-addon-manager",
  "description": "WPS Office ET 插件管理器，支持可信控件源、SHA-256 校验、安装、卸载与权限恢复。",
  "keywords": [
    "wps",
    "wps-office",
    "wps-addon",
    "wps-plugin",
    "wps-js-addin",
    "tauri",
    "plugin-manager"
  ],
  "homepage": "https://github.com/huzhengxi/wps-addon-manager",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huzhengxi/wps-addon-manager.git"
  },
  "bugs": {
    "url": "https://github.com/huzhengxi/wps-addon-manager/issues"
  },
  "private": true,
  "version": "0.0.15",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "check": "npm run build",
    "package:zip": "node scripts/package-macos-zip.mjs",
    "package:zip:local": "node scripts/package-macos-zip.mjs --no-sign",
    "package:macos": "node scripts/package-platform.mjs macos",
    "package:windows": "node scripts/package-platform.mjs windows",
    "package:linux": "node scripts/package-platform.mjs linux",
    "sync:addon": "node scripts/sync-addon-resources.mjs --skip-build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@tauri-apps/api": "2.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "5.7.3",
    "vite": "^8.2.2"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-darwin-arm64": "2.11.4",
    "@tauri-apps/cli-darwin-x64": "2.11.4",
    "@tauri-apps/cli-linux-x64-gnu": "2.11.4",
    "@tauri-apps/cli-win32-x64-msvc": "2.11.4"
  }
}
